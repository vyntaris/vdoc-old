<?xml version="1.0" encoding="utf-8"?>
<!--
  VDoc MSI (WiX Toolset v5: `dotnet tool install -g wix`). Built by package.ps1:

    wix build vdoc.wxs -arch x64 -d Version=1.2.3 -d BinDir=... -d IconPath=... -o out.msi

  Per-machine install into Program Files, a Start Menu shortcut, `.pcraft` owned by VDoc,
  and VDoc offered under "Open with" for PSD/PSB and the image formats it reads (without
  taking over the user's default app for them).
-->
<Wix xmlns="http://wixtoolset.org/schemas/v4/wxs">
  <Package
      Name="VDoc"
      Manufacturer="Learning Machines LLC"
      Version="$(var.Version)"
      UpgradeCode="49E87D30-BB68-4896-AA1D-F45C833CFC3C"
      Scope="perMachine"
      Compressed="yes"
      Language="1033">
    <SummaryInformation Description="VDoc word processor" Manufacturer="Learning Machines LLC" />
    <!-- Same-version upgrades let successive pre-releases of one X.Y.Z replace each other
         (MSI versions are numeric, so 1.2.3-rc.1 and 1.2.3-rc.2 are both 1.2.3). -->
    <MajorUpgrade AllowSameVersionUpgrades="yes"
        DowngradeErrorMessage="A newer version of VDoc is already installed." />
    <MediaTemplate EmbedCab="yes" CompressionLevel="high" />

    <Icon Id="VdocIcon.ico" SourceFile="$(var.IconPath)" />
    <Property Id="ARPPRODUCTICON" Value="VdocIcon.ico" />
    <Property Id="ARPURLINFOABOUT" Value="https://getartcraft.com/apps/vdoc" />
    <Property Id="ARPURLUPDATEINFO" Value="https://getartcraft.com/apps/vdoc" />
    <Property Id="ARPHELPLINK" Value="https://discord.gg/artcraft" />

    <StandardDirectory Id="ProgramFiles6432Folder">
      <Directory Id="INSTALLFOLDER" Name="VDoc" />
    </StandardDirectory>
    <StandardDirectory Id="ProgramMenuFolder" />

    <Feature Id="Main" Title="VDoc" Level="1">
      <ComponentGroupRef Id="VdocFiles" />
    </Feature>
  </Package>

  <Fragment>
    <ComponentGroup Id="VdocFiles" Directory="INSTALLFOLDER">
      <Component Id="VdocApp" Guid="DE018EF3-EE87-4E36-9F76-0B7B060A195E">
        <File Id="VdocExe" Source="$(var.BinDir)\vdoc.exe" KeyPath="yes">
          <Shortcut Id="StartMenuShortcut" Directory="ProgramMenuFolder" Name="VDoc"
              Description="VDoc word processor" WorkingDirectory="INSTALLFOLDER" Advertise="yes"
              Icon="VdocIcon.ico" IconIndex="0" />
        </File>

        <RegistryValue Root="HKLM" Key="Software\Microsoft\Windows\CurrentVersion\App Paths\vdoc.exe" Value="[#VdocExe]" Type="string" />
      </Component>

      <Component Id="VdocCli">
        <File Id="VdocCliExe" Source="$(var.BinDir)\vdoc-cli.exe" KeyPath="yes" />
      </Component>
    </ComponentGroup>
  </Fragment>
</Wix>
